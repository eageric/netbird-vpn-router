# Copy to .env and replace the placeholders. Do not commit .env.

# Setup key from the NetBird dashboard (Setup Keys).
# A one-off key is enough while the netbird-it-router volume exists.
# Use a reusable key if that volume may be recreated.
NB_SETUP_KEY=replace-with-setup-key

# Self-hosted management URL. No path.
# Use the same host as NETBIRD_DOMAIN on the NetBird server.
NB_MANAGEMENT_URL=https://netbird.example.com

# Peer name shown in the dashboard. The dashboard Network for the EAG
# internal ranges used by IT should use this peer as its routing peer.
NB_HOSTNAME=netbird-it-router

# Client log level: error, warn, info, debug, or trace.
NB_LOG_LEVEL=info
